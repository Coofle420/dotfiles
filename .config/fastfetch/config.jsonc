{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // One colour everywhere: matches Noctalia primary (DarkPurple)
  "logo": {
    "type": "auto",
    "color": { "1": "#b388ff", "2": "#b388ff", "3": "#b388ff", "4": "#b388ff", "5": "#b388ff", "6": "#b388ff" },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#b388ff", "title": "#b388ff", "separator": "#b388ff", "output": "#e9e0ff" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
