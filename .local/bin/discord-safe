#!/bin/sh
# Discord launcher wrapper:
#  - XWayland mode so push-to-talk keybinds can be recorded
#  - GPU video encoding off (LIBVA_DRIVERS_PATH points nowhere): Discord's VA-API encoder crashed screen shares
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
export LIBVA_DRIVERS_PATH=/nonexistent
exec /usr/bin/discord --ozone-platform=x11 "$@"
