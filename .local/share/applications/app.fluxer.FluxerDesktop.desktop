[Desktop Entry]
# X-Generated-By=fluxer-desktop
Type=Application
Version=1.5
Name=Fluxer
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec="/opt/fluxer-bin/fluxer" %U
TryExec=/opt/fluxer-bin/fluxer
Icon=fluxer
Terminal=false
Categories=Network;InstantMessaging;Chat;
MimeType=x-scheme-handler/fluxer;
StartupWMClass=app.fluxer.FluxerDesktop
SingleMainWindow=true
StartupNotify=true
NoDisplay=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open settings
Exec="/opt/fluxer-bin/fluxer" --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New direct message
Exec="/opt/fluxer-bin/fluxer" --fluxer-task=new-dm %U
